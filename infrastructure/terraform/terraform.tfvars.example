# GitHub repository in owner/repo format
github_repository = "JacobSteelsmith/resume"

# AWS account ID (treat as sensitive)
aws_account_id = "123456789012"

# AWS region
aws_region = "us-east-1"

# Deployment environment
environment = "production"

# Domain name for the resume site
domain_name = "resume.jacob.steelsmith.org"

# Route 53 hosted zone ID for steelsmith.org
hosted_zone_id = "Z1234567890ABC"

# Bedrock foundation model ID for the RAG chatbot
bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"
