---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Page Not Found | Jacob Steelsmith"
    description="The page you're looking for doesn't exist. Return to the homepage to explore Jacob Steelsmith's resume, projects, and cloud engineering expertise."
    ogType="website"
  />

  <section class="error-page" aria-labelledby="error-heading">
    <h1 id="error-heading">404</h1>
    <p class="error-subtitle">Page Not Found</p>
    <p class="error-message">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="home-link">Back to Homepage</a>
  </section>
</BaseLayout>

<style>
  .error-page {
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .error-page h1 {
    font-size: clamp(4rem, 10vw, 8rem);
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .error-subtitle {
    font-size: var(--font-size-2xl);
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }

  .error-message {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .home-link {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background-color: var(--color-primary);
    color: var(--color-bg);
    text-decoration: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .home-link:hover,
  .home-link:focus {
    opacity: 0.85;
  }
</style>
