---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout class="projects-page">
  <SEOHead
    slot="head"
    title="Projects | Jacob Steelsmith"
    description="Key projects showcasing AWS cloud engineering, infrastructure as code, and full-stack development expertise."
  />

  <h1>Projects</h1>
  <p class="page-intro">
    A selection of projects demonstrating cloud architecture, infrastructure as code, and modern web development.
  </p>

  <section class="projects-grid" aria-label="Project list">
    <ProjectCard
      title="Resume Site (IaC)"
      description="This site — a fully automated resume platform with all infrastructure managed by Terraform. Features a RAG-powered AI chatbot using Amazon Bedrock, S3 + CloudFront hosting with OAC, GitHub Actions CI/CD with OIDC, and OpenSearch Serverless vector store."
      technologies={['Astro', 'Terraform', 'Amazon Bedrock', 'OpenSearch Serverless', 'Lambda', 'API Gateway', 'S3', 'CloudFront', 'WAF', 'GitHub Actions']}
      sourceUrl="https://github.com/JacobSteelsmith/resume"
      liveUrl="https://resume.jacob.steelsmith.org"
    />

    <ProjectCard
      title="Bedrock AgentCore Agents"
      description="A production agentic AI platform on Amazon Bedrock AgentCore in a large enterprise environment. Implemented the agent harness, with Confluence as the knowledge source (via AgentCore Gateway) and Microsoft Teams as the delivery channel. Uses AgentCore Runtime, Memory, Identity, and Observability for session-isolated, grounded, cited answers."
      technologies={['Amazon Bedrock AgentCore', 'AgentCore Harness', 'RAG', 'Confluence', 'Microsoft Teams', 'Microsoft Graph', 'OAuth2', 'Python', 'CloudWatch']}
    />

    <ProjectCard
      title="Grafana Observability Platform"
      description="Enterprise data-store monitoring built with Grafana over CloudWatch metrics. Designed dashboards and configured multi-channel, severity-based alerting across DynamoDB, ElastiCache (Valkey), Redshift, and RDS — giving on-call engineers a single pane of glass in a large corporate environment."
      technologies={['Grafana', 'Amazon CloudWatch', 'DynamoDB', 'ElastiCache (Valkey)', 'Redshift', 'RDS', 'Alerting', 'IAM']}
    />

    <ProjectCard
      title="Candidate Portal"
      description="A full-featured serverless web application with 90+ Python Lambda functions, Aurora Serverless MySQL via RDS Data API, and complete e-commerce with Stripe. Handles candidate registration, exam scheduling, payments, and document management at scale with zero connection pooling overhead."
      technologies={['React', 'AWS Amplify Gen2', 'Python', 'Lambda', 'Aurora Serverless', 'RDS Data API', 'Cognito', 'Stripe', 'API Gateway']}
    />

    <ProjectCard
      title="Dev Data ETL Pipeline"
      description="A Python-based ETL pipeline that generates safe development datasets from production databases. Extracts schema and data from multiple RDS instances, obfuscates all PII with Faker, and produces SQL dumps maintaining full referential integrity across databases."
      technologies={['Python', 'AWS RDS', 'Secrets Manager', 'ECS', 'SQL', 'Docker', 'SNS']}
    />

    <ProjectCard
      title="Blog & Portfolio"
      description="A long-running technical blog and portfolio site built with Astro and deployed via AWS Amplify. Managed hosting with auto-builds on push, zero client-side JavaScript, and Markdown content collections spanning 20 years of posts."
      technologies={['Astro', 'AWS Amplify', 'TypeScript', 'Markdown', 'Route 53']}
      sourceUrl="https://github.com/JacobSteelsmith/portfolio"
      liveUrl="https://jacob.steelsmith.org"
    />

    <ProjectCard
      title="Remote Proctoring Platform"
      description="Built in ~3 weeks during COVID disruptions, replacing a $50K vendor solution. Enables remote test proctoring via real-time video streaming with AWS Kinesis Video Streams and custom backend services."
      technologies={['AWS Kinesis Video Streams', 'Lambda', 'API Gateway', 'JavaScript', 'Real-time streaming']}
    />

    <ProjectCard
      title="Real-Time Video Platform"
      description="A streaming and recording platform for testing workflows using LiveKit on Kubernetes. Supports WebRTC-based video with container orchestration on EKS and Helm-managed deployments."
      technologies={['LiveKit', 'Kubernetes', 'EKS', 'Helm', 'WebRTC', 'Real-time streaming']}
    />

    <ProjectCard
      title="MySQL-to-RDS Data API Proxy"
      description="A middleware proxy enabling standard MySQL clients to connect to AWS RDS Data API. Bridges traditional database tooling with serverless database access patterns, improving developer workflows."
      technologies={['AWS RDS Data API', 'MySQL', 'Middleware', 'Serverless']}
    />

    <ProjectCard
      title="Platform Modernization"
      description="Led incremental migration of a monolithic ColdFusion application to AWS-based distributed architecture. Serverless APIs, React frontend, and managed services improved deployment efficiency by ~40%."
      technologies={['AWS Lambda', 'API Gateway', 'React', 'RDS', 'CFML', 'Terraform']}
    />
  </section>
</BaseLayout>

<style>
  :global(.projects-page) {
    max-width: 960px;
  }

  .page-intro {
    margin-bottom: var(--space-2xl);
    color: var(--color-text-muted);
  }

  .projects-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
