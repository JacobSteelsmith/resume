---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Resume | Jacob Steelsmith"
    description="Resume of Jacob Steelsmith — Staff/Principal Engineer with 20+ years of experience in AI systems, cloud architecture, distributed systems, and engineering leadership."
  />

  <h1>Resume</h1>

  <section class="resume-section" aria-labelledby="summary-heading">
    <h2 id="summary-heading">Professional Summary</h2>
    <p>Hands-on software engineer and engineering leader with 20+ years of experience architecting and operating scalable cloud, data, and distributed systems. Background spans agentic AI development, AWS serverless architecture, platform modernization, and full-stack application development, with a focus on building reliable systems that support real-world operational workflows at scale.</p>
    <p>Proven track record delivering high-volume transactional systems, real-time platforms, and production services supporting thousands of users. Experienced in modern development practices including CI/CD, automated testing, and AI-assisted development.</p>
  </section>

  <section class="resume-section" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>

    <h3>Languages</h3>
    <ul class="skill-list">
      <li>JavaScript</li>
      <li>Bash</li>
      <li>Python</li>
      <li>SQL</li>
      <li>CFML</li>
      <li>PHP</li>
    </ul>

    <h3>AI &amp; Automation</h3>
    <ul class="skill-list">
      <li>Agentic AI Development (Kiro)</li>
      <li>MCP Servers</li>
      <li>RAG (Amazon Bedrock)</li>
    </ul>

    <h3>Backend &amp; APIs</h3>
    <ul class="skill-list">
      <li>REST APIs</li>
      <li>Backend services</li>
      <li>Data modeling</li>
      <li>Transactional systems</li>
    </ul>

    <h3>Frontend</h3>
    <ul class="skill-list">
      <li>React</li>
      <li>Modern JavaScript frameworks</li>
    </ul>

    <h3>Cloud &amp; Infrastructure</h3>
    <ul class="skill-list">
      <li>AWS Lambda</li>
      <li>API Gateway</li>
      <li>Cognito</li>
      <li>RDS</li>
      <li>S3</li>
      <li>CloudWatch</li>
      <li>CloudFormation</li>
      <li>Glue</li>
      <li>Redshift</li>
      <li>EKS</li>
      <li>Kinesis</li>
      <li>Amplify</li>
      <li>Serverless architecture</li>
      <li>Kubernetes</li>
    </ul>

    <h3>Systems</h3>
    <ul class="skill-list">
      <li>Distributed systems</li>
      <li>Event-driven architecture</li>
      <li>Real-time streaming</li>
    </ul>

    <h3>Databases</h3>
    <ul class="skill-list">
      <li>MySQL</li>
      <li>SQL Server</li>
      <li>DynamoDB</li>
      <li>Redshift</li>
      <li>Schema design</li>
      <li>DBMS management</li>
    </ul>

    <h3>Tools</h3>
    <ul class="skill-list">
      <li>Git</li>
      <li>CI/CD pipelines</li>
      <li>Playwright</li>
      <li>pytest</li>
    </ul>

    <h3>Leadership</h3>
    <ul class="skill-list">
      <li>Hiring</li>
      <li>Mentoring</li>
      <li>Performance management</li>
      <li>Delivery ownership</li>
    </ul>
  </section>

  <section class="resume-section" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Work Experience</h2>

    <article class="experience-item">
      <h3>Director of Information Technology (Engineering &amp; Cloud)</h3>
      <p class="experience-meta">
        <span class="company">National Testing Network</span>
        <span class="separator" aria-hidden="true">&middot;</span>
        <time datetime="2015-09">Sep 2015</time> &ndash; Present
      </p>
      <ul class="experience-details">
        <li>Built and operated customer-facing SaaS platform serving thousands of users, owning availability, performance, and reliability across production systems</li>
        <li>Built and led engineering teams (up to 7 members), including hiring, mentoring, and establishing development and operational best practices</li>
        <li>Led modernization from a monolithic ColdFusion application to AWS-based distributed architecture (serverless, APIs, React), improving deployment efficiency by ~40%</li>
        <li>Built a remote proctoring platform in ~3 weeks using AWS Kinesis Video Streams, replacing a $50K vendor solution and enabling continued operations during COVID disruptions</li>
        <li>Designed and implemented a real-time video platform using LiveKit, Kubernetes (EKS), and Helm to support streaming and recording workflows</li>
        <li>Built a middleware proxy enabling standard MySQL clients to connect to AWS RDS Data API, improving developer workflows and enabling serverless database usage</li>
        <li>Implemented CI/CD pipelines and automated testing using Playwright and pytest, improving release reliability and reducing regression risk</li>
        <li>Partnered with executive leadership on technical strategy, prioritization, and budgeting decisions</li>
        <li>Implemented AI-assisted development workflows to improve team productivity and accelerate delivery</li>
      </ul>
    </article>

    <article class="experience-item">
      <h3>Senior Web Developer</h3>
      <p class="experience-meta">
        <span class="company">National Testing Network</span>
        <span class="separator" aria-hidden="true">&middot;</span>
        <time datetime="2013">2013</time> &ndash; <time datetime="2015">2015</time>
      </p>
      <ul class="experience-details">
        <li>Built and maintained 8 high-traffic web applications serving tens of thousands of users with ~99.9% uptime</li>
        <li>Designed and executed migration from a single-server environment to AWS (Lucee on Elastic Beanstalk, RDS), improving uptime by ~80% and performance by ~60%</li>
        <li>Developed full-stack applications and backend systems supporting public safety testing and licensing workflows</li>
        <li>Standardized development practices and built internal frameworks, improving development speed by ~25%</li>
      </ul>
    </article>

    <article class="experience-item">
      <h3>Software Developer</h3>
      <p class="experience-meta">
        <span class="company">Everett Community College</span>
        <span class="separator" aria-hidden="true">&middot;</span>
        <time datetime="2005">2005</time> &ndash; <time datetime="2013">2013</time>
      </p>
      <ul class="experience-details">
        <li>Developed and maintained full-stack web applications using CFML, SQL Server, and JavaScript</li>
        <li>Built backend systems and database-driven applications supporting academic and administrative workflows</li>
        <li>Designed and implemented application features focused on usability, performance, and maintainability</li>
      </ul>
    </article>

    <article class="experience-item">
      <h3>Instructor &mdash; Database Design (Part-Time)</h3>
      <p class="experience-meta">
        <span class="company">Everett Community College</span>
      </p>
      <ul class="experience-details">
        <li>Taught database design and SQL fundamentals across multiple academic quarters</li>
      </ul>
    </article>
  </section>

  <section class="resume-section" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <p><strong>B.S. Cloud and Network Engineering</strong> &mdash; Western Governors University (expected June 2026)</p>
  </section>

  <section class="resume-section" aria-labelledby="certifications-heading">
    <h2 id="certifications-heading">Certifications</h2>
    <ul class="certification-list">
      <li><strong>AWS Certified SysOps Administrator – Associate</strong><span class="cert-date">Sep 2025</span></li>
      <li><strong>AWS Certified Developer – Associate</strong><span class="cert-date">Jul 2025</span></li>
      <li><strong>ITIL Foundation</strong><span class="cert-date">Oct 2024</span></li>
      <li><strong>CompTIA Security+</strong><span class="cert-date">Jul 2024</span></li>
      <li><strong>CompTIA Cloud+</strong><span class="cert-date">Dec 2023</span></li>
      <li><strong>AWS Certified Cloud Practitioner</strong><span class="cert-date">Oct 2023</span></li>
      <li><strong>CompTIA Project+</strong><span class="cert-date">Jun 2023</span></li>
      <li><strong>CompTIA Network+</strong><span class="cert-date">Mar 2023</span></li>
      <li><strong>Linux Essentials (LPI)</strong><span class="cert-date">Aug 2022</span></li>
      <li><strong>CompTIA A+</strong><span class="cert-date">Jun 2022</span></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .resume-section {
    margin-bottom: var(--space-2xl);
  }

  .resume-section h2 {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border);
  }

  .resume-section h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .skill-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .skill-list li {
    background-color: var(--color-bg-alt);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    border: 1px solid var(--color-border);
  }

  .experience-item {
    margin-bottom: var(--space-xl);
  }

  .experience-item h3 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .experience-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-md);
  }

  .experience-meta .company {
    font-weight: 600;
    color: var(--color-text);
  }

  .experience-meta .separator {
    margin-inline: var(--space-sm);
  }

  .experience-details {
    padding-left: var(--space-lg);
  }

  .experience-details li {
    margin-bottom: var(--space-sm);
    max-width: var(--content-max-width);
  }

  .certification-list {
    list-style: none;
    padding: 0;
  }

  .certification-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .certification-list li:last-child {
    border-bottom: none;
  }

  .cert-date {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    flex-shrink: 0;
    margin-left: var(--space-md);
  }

  @media (max-width: 768px) {
    .skill-list {
      gap: var(--space-xs);
    }
  }
</style>
