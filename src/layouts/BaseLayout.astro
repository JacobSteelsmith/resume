---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const chatApiUrl = import.meta.env.PUBLIC_CHAT_API_URL || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <Navigation />
    </header>

    <main id="main-content" class:list={['content', className]}>
      <slot />
    </main>

    <footer class="site-footer">
      <slot name="footer">
        <p>&copy; {new Date().getFullYear()} Jacob Steelsmith. All rights reserved.</p>
      </slot>
    </footer>

    {chatApiUrl && (
      <script is:inline define:vars={{ chatApiUrl }}>
        window.__CHAT_API_URL = chatApiUrl;
      </script>
    )}
    <ChatWidget />
  </body>
</html>
